# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=offscript-dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/offscript-dev

# API
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Ollama / AI
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m

# Host used by the API container to reach Ollama running on the host
OLLAMA_HOST_DOCKER=http://host.docker.internal:11434
